{
  "name": "primer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx scripts/seed.ts",
    "curriculum": "tsx scripts/curriculum.ts",
    "voice:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx agents/primer.ts dev",
    "voice:start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx agents/primer.ts start",
    "voice:download": "livekit-agents download-files"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/agents-plugin-cartesia": "^1.9.0",
    "@livekit/agents-plugin-deepgram": "^1.9.0",
    "@livekit/agents-plugin-silero": "^1.9.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "openai": "^7.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
