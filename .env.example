# Node >=22.13. Persistent disk required; do not deploy this SQLite adapter to ephemeral serverless hosts.
DATABASE_PATH=./data/primer.sqlite
# Optional. Leave blank for fully authored deterministic lessons.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Balanced setup: extraction on Luna, teaching on Sol. Explicit overrides win.
OPENAI_INTERPRETER_MODEL=gpt-6-luna
OPENAI_TUTOR_MODEL=gpt-6.1-sol
# Voice pause detection in milliseconds. Raise this for learners who need longer pauses.
PRIMER_VOICE_END_DELAY_MS=1200
# Optional realtime voice service. If any value in this block is absent,
# lessons fall back to the browser speech adapter and retain text controls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PRIMER_WORKER_SECRET=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=
# Publicly reachable Da Vinci origin used only by the private voice worker.
PRIMER_SERVER_URL=http://localhost:3000
# HTTPS production origins; cookie security defaults to production mode.
APP_ORIGIN=http://localhost:3000
# Development only; seed command refuses production.
DEMO_PASSWORD=
